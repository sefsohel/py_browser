worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    keepalive_timeout 65;

    server {
        listen ${PORT};
        server_name _;

        # noVNC assets are served directly by nginx.
        root /usr/share/novnc;

        # Health endpoint is provided by the Python 3.11 service.
        location = /healthz {
            proxy_pass http://127.0.0.1:${APP_PORT}/healthz;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = /api/info {
            proxy_pass http://127.0.0.1:${APP_PORT}/api/info;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Start noVNC with the real Chromium desktop already connected.
        location = / {
            add_header Cache-Control "no-store" always;
            return 302 /vnc.html?autoconnect=true&reconnect=true&resize=scale&path=websockify;
        }

        # WebSocket bridge: browser <-> noVNC <-> websockify <-> VNC.
        location /websockify {
            proxy_pass http://127.0.0.1:6080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # noVNC uses query-string options and must revalidate its HTML assets.
        location / {
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri/ =404;
        }
    }
}
