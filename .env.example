# Required: login for the web UI (HTTP basic auth via nginx)
BROWSER_USER=admin
BROWSER_PASSWORD=change-me-to-a-long-random-string

# Optional
HOME_URL=https://duckduckgo.com
MAX_SESSIONS=2          # concurrent users; each one costs ~300-600 MB RAM
JPEG_QUALITY=60         # 30-90; lower = less bandwidth
IDLE_TIMEOUT=900        # seconds before an idle session is closed
LOG_LEVEL=INFO

# Local testing only (never on a public deployment):
# ALLOW_NO_AUTH=true

# PORT is injected by Railway automatically (defaults to 8080 locally)
